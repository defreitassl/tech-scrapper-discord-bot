{
  "name": "discord-jobs-bot",
  "version": "0.1.0",
  "description": "Painel para coletar e publicar vagas de tecnologia para iniciantes no Discord.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prod": "node dist/admin/server.js",
    "admin": "node dist/admin/server.js",
    "diagnose:domain": "node dist/scripts/diagnoseJobDomainClassifier.js",
    "diagnose:providers": "node dist/scripts/diagnoseProviders.js",
    "diagnose:priority": "node dist/scripts/diagnoseJobPriority.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "discord",
    "jobs",
    "bot"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.17",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3"
  }
}
