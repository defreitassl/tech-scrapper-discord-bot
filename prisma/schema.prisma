generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  DRAFT
  PENDING
  SENT
  ERROR
  ARCHIVED
}

enum JobPriority {
  HIGH
  MEDIUM
  LOW
}

model JobPost {
  id               String    @id @default(cuid())
  title            String?
  company          String?
  location         String?
  modality         String?
  level            String?
  stacks           String?
  salaryRange      String?
  shortDescription String?
  url              String?
  source           String?
  rawText          String?
  readyText        String?
  aiGeneratedText  String?
  useAi            Boolean   @default(false)
  status           JobStatus @default(DRAFT)
  priority         JobPriority?
  priorityScore    Int?
  priorityReasons  String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([sentAt])
}

model SchedulerSettings {
  id         String   @id @default("default")
  enabled    Boolean  @default(false)
  dailyLimit Int      @default(5)
  timezone   String   @default("America/Sao_Paulo")
  sendTimes  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
